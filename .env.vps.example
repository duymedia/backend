# Copy to .env on the VPS. Do not commit .env.
NODE_ENV=production
PORT=3000

# Access by VPS IP. Change to https://your-domain when a domain is ready.
APP_URL=http://103.229.52.143
FRONTEND_URL=http://103.229.52.143
EXTRA_CORS_ORIGINS=http://103.229.52.143

JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d

# MySQL Docker
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_DATABASE=app_db
MYSQL_USER=app_user
MYSQL_PASSWORD=replace-with-a-strong-app-password
