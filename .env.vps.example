# Copy this file to .env on the VPS. Do not commit the real .env file.
MYSQL_ROOT_PASSWORD=replace-with-a-long-root-password
MYSQL_DATABASE=defaultdb
MYSQL_USER=appuser
MYSQL_PASSWORD=replace-with-a-long-app-password

# Public HTTPS URL served by Nginx and Cloudflare.
APP_URL=https://aqi.io.vn
FRONTEND_URL=https://frontend-ten-gamma-17.vercel.app
EXTRA_CORS_ORIGINS=https://frontend-ten-gamma-17.vercel.app

JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
