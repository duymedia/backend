# Copy to .env on the VPS. Do not commit the real .env.
NODE_ENV=production
PORT=3000

APP_URL=http://103.229.52.143
FRONTEND_URL=http://103.229.52.143
EXTRA_CORS_ORIGINS=http://103.229.52.143
VITE_API_BASE_URL=http://103.229.52.143

JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d

# Database container credentials. DATABASE_URL is optional: Docker injects DB_*.
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_DATABASE=app_db
MYSQL_USER=app_user
MYSQL_PASSWORD=replace-with-a-strong-app-password

# Optional integrations
GEMINI_API_KEY=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
