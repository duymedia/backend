# Copy to .env on the VPS. Never commit the real .env file.
NODE_ENV=production
PORT=3000

# Public URLs (no trailing slash)
APP_URL=https://api.example.com
FRONTEND_URL=https://app.example.com
EXTRA_CORS_ORIGINS=https://app.example.com
VITE_API_BASE_URL=https://api.example.com

# Authentication
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d

# MySQL: use one connection string (recommended)
DATABASE_URL=mysql://db_user:db_password@db_host:3306/db_name
DB_SSL=false

# Optional integrations: add only when the feature is enabled.
GEMINI_API_KEY=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
